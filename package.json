{
  "name": "batcontrol",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/artifact.mjs",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "test": "tsx scripts/test-lessons.ts && tsx scripts/test-puzzles.ts && tsx scripts/test-i18n.ts && node scripts/dictdiff.mjs en es fr de zh ja",
    "preview": "vite preview --outDir dist-pages"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/lang-python": "^6.1.7",
    "@codemirror/language": "^6.11.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.1",
    "@pybricks/mpy-cross-v6": "^2.0.0",
    "codemirror": "^6.0.1",
    "qrcode-generator": "^2.0.4",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "playwright": "^1.55.0",
    "tsx": "^4.20.0",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.4"
  }
